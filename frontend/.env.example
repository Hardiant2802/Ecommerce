# Magento API Configuration
NEXT_PUBLIC_MAGENTO_GRAPHQL_URL=http://localhost/graphql
NEXT_PUBLIC_MAGENTO_API_URL=http://localhost
NEXT_PUBLIC_MAGENTO_STORE_CODE=default
# Optional: force edge proxy to always use this Magento backend (recommended in production)
MAGENTO_GRAPHQL_UPSTREAM_URL=https://magento.ahphonestore.id.vn/graphql

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Mobile Phone Store

# Registration OTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_MINUTES=15
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mobile-store
