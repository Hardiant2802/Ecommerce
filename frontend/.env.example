# Magento API Configuration
NEXT_PUBLIC_MAGENTO_GRAPHQL_URL=http://localhost/graphql
NEXT_PUBLIC_MAGENTO_API_URL=http://localhost
NEXT_PUBLIC_MAGENTO_STORE_CODE=default
# Optional: force edge proxy to always use this Magento backend (recommended in production)
MAGENTO_GRAPHQL_UPSTREAM_URL=https://magento.ahphonestore.id.vn/graphql

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=AH Phone Store

# Bank transfer / QR
NEXT_PUBLIC_BANK_NAME=BIDV
# Optional explicit SePay bank code used for dynamic QR URL
NEXT_PUBLIC_SEPAY_BANK_CODE=BIDV
NEXT_PUBLIC_BANK_BIN=
NEXT_PUBLIC_BANK_ACCOUNT_NO=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_TRANSFER_PREFIX=DH

# SePay integration (server-side use for webhook validation)
# Integration mode: api_access (recommended) or webhook
SEPAY_INTEGRATION_MODE=api_access
# SePay API access token for pull-check (from my.sepay.vn/companyapi; use raw token or Bearer token)
SEPAY_API_TOKEN=
# Optional: SePay transactions endpoint used by proactive payment check route
SEPAY_TRANSACTIONS_API_URL=https://my.sepay.vn/userapi/transactions/list
# SePay Webhook API key (for webhook auth only)
SEPAY_WEBHOOK_API_KEY=
# Recommended: expected receiving accounts for SePay matching.
# Supports comma-separated values (main account + VA), e.g. 8876152012,VA123456
# If omitted, system falls back to NEXT_PUBLIC_BANK_ACCOUNT_NO.
SEPAY_EXPECTED_ACCOUNT_NUMBER=
# Optional aliases for compatibility (also comma-separated)
SEPAY_EXPECTED_ACCOUNTS=
SEPAY_EXPECTED_VA=
# Optional: force checkout QR and created banking orders to use this receiving account/VA.
# Use this when SePay requires transfer to VA (e.g. BIDV VA flow).
SEPAY_RECEIVING_ACCOUNT_NO=
SEPAY_RECEIVING_ACCOUNT_NAME=
# Optional: enforce webhook source IP whitelist
SEPAY_WEBHOOK_ENFORCE_IP_WHITELIST=false
# Optional: comma-separated IPs. Empty = use built-in SePay IP defaults.
SEPAY_WEBHOOK_ALLOWED_IPS=172.236.138.20,172.233.83.68,171.244.35.2,151.158.108.68,151.158.109.79,103.255.238.139
# Optional: cooldown between proactive pull checks for same order (milliseconds)
SEPAY_CHECK_COOLDOWN_MS=4000
SEPAY_TEST_AMOUNT_VND=0

# Internal order persistence via Cloudflare KV REST API
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Admin key to view internal orders page (/admin/orders?key=...)
INTERNAL_ORDERS_ADMIN_KEY=

# Magento sync defaults for guest order placement
MAGENTO_SYNC_EMAIL_FALLBACK=
MAGENTO_SYNC_FULLNAME=
MAGENTO_SYNC_FIRSTNAME=
MAGENTO_SYNC_LASTNAME=
MAGENTO_SYNC_TELEPHONE=
MAGENTO_SYNC_STREET=
MAGENTO_SYNC_CITY=
MAGENTO_SYNC_REGION=
MAGENTO_SYNC_POSTCODE=
MAGENTO_SYNC_COUNTRY=VN
MAGENTO_SYNC_SHIPPING_CARRIER=flatrate
MAGENTO_SYNC_SHIPPING_METHOD=flatrate
MAGENTO_SYNC_PAYMENT_CODE=checkmo
