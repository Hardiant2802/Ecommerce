+
+              {mobileCitySourceUrl && (
+                <p className="text-xs text-gray-500 mt-3">
+                  Nguon doi soat: <a href={mobileCitySourceUrl} target="_blank" rel="noreferrer" className="text-primary-700 underline">MobileCity</a>
+                </p>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
     </div>
   );
 }
