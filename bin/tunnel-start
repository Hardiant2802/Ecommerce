#!/usr/bin/env bash
set -o errexit

TOKEN_FILE="env/cloudflare.local.env"
if [ ! -f "$TOKEN_FILE" ]; then
  TOKEN_FILE="env/cloudflare.env"
fi

if [ ! -f "$TOKEN_FILE" ]; then
  echo "Missing $TOKEN_FILE"
  exit 1
fi

TOKEN=$(grep '^TUNNEL_TOKEN=' "$TOKEN_FILE" | cut -d'=' -f2-)
if [ -z "$TOKEN" ]; then
  echo "TUNNEL_TOKEN is empty."
  echo "1) Create tunnel + hostname in Cloudflare Zero Trust"
  echo "2) Paste token into env/cloudflare.local.env (recommended)"
  echo "   or env/cloudflare.env"
  echo "3) Re-run: bin/tunnel-start"
  exit 1
fi

echo "Using tunnel token from $TOKEN_FILE"
export TUNNEL_TOKEN="$TOKEN"

if ! bin/docker-compose --profile tunnel up -d --no-deps tunnel; then
  echo "docker-compose tunnel start failed, trying direct container fallback..."
  if docker ps -a --format '{{.Names}}' | grep -Eq '^e-commerce[-_]tunnel[-_]1$'; then
    docker start e-commerce-tunnel-1 >/dev/null 2>&1 || docker start e-commerce_tunnel_1
  else
    docker run -d \
      --name e-commerce-tunnel-1 \
      --network e-commerce_default \
      --restart unless-stopped \
      -e TUNNEL_TOKEN="$TUNNEL_TOKEN" \
      cloudflare/cloudflared:latest \
      tunnel --no-autoupdate run
  fi
fi

docker ps --filter name=e-commerce-tunnel-1 --filter name=e-commerce_tunnel_1
