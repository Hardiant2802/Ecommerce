#!/usr/bin/env bash
# Tự động kiểm tra và reindex nếu Magento không có sản phẩm
# Chạy qua cron mỗi 5 phút

COMPOSE_DIR="/root/E-commerce"

# Kiểm tra OpenSearch có chạy không
OPENSEARCH_UP=$(docker exec e-commerce-opensearch-1 curl -s -o /dev/null -w "%{http_code}" http://localhost:9200 2>/dev/null || echo "000")
if [ "$OPENSEARCH_UP" != "200" ]; then
  echo "[$(date)] OpenSearch chưa sẵn sàng ($OPENSEARCH_UP), bỏ qua"
  exit 0
fi

# Kiểm tra có sản phẩm không
PRODUCT_COUNT=$(docker exec e-commerce-phpfpm-1 php /var/www/html/bin/magento catalog:product:count 2>/dev/null | grep -oP '\d+' | head -1 || echo "0")

# Thử qua GraphQL API
if [ -z "$PRODUCT_COUNT" ] || [ "$PRODUCT_COUNT" = "0" ]; then
  GQL_COUNT=$(curl -s "http://localhost:3000/api/graphql" -X POST -H "Content-Type: application/json" \
    -d '{"query":"{ products(filter:{category_id:{eq:\"55\"}},pageSize:1) { total_count } }"}' \
    2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('data',{}).get('products',{}).get('total_count',0))" 2>/dev/null || echo "0")
  
  if [ "$GQL_COUNT" = "0" ]; then
    echo "[$(date)] Phát hiện 0 sản phẩm, đang reindex..."
    docker compose -f "$COMPOSE_DIR/compose.yaml" exec phpfpm php bin/magento indexer:reindex catalogsearch_fulltext 2>&1
    docker compose -f "$COMPOSE_DIR/compose.yaml" exec phpfpm php bin/magento cache:flush 2>&1
    echo "[$(date)] Reindex xong"
  else
    echo "[$(date)] OK: $GQL_COUNT sản phẩm"
  fi
else
  echo "[$(date)] OK: $PRODUCT_COUNT sản phẩm"
fi
