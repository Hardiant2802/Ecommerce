#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

BACKUP_DIR="${ROOT_DIR}/backups/db"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
OUT_FILE="${BACKUP_DIR}/magento_${TIMESTAMP}.sql.gz"
TMP_FILE="${OUT_FILE}.tmp"

mkdir -p "$BACKUP_DIR"

echo "Creating DB backup: ${OUT_FILE}"
bin/docker-compose exec -T db sh -lc '
if command -v mysqldump >/dev/null 2>&1; then
	exec mysqldump -umagento -pmagento magento
elif command -v mariadb-dump >/dev/null 2>&1; then
	exec mariadb-dump -umagento -pmagento magento
else
	echo "Neither mysqldump nor mariadb-dump is available in db container" >&2
	exit 127
fi
' | gzip -c > "$TMP_FILE"

mv "$TMP_FILE" "$OUT_FILE"

echo "Backup completed: ${OUT_FILE}"
ls -lh "$OUT_FILE"
