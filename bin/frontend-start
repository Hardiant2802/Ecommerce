#!/usr/bin/env bash
set -o errexit

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR/frontend"

REBUILD=false
if [ "$1" = "--rebuild" ]; then
  REBUILD=true
fi

if ss -ltn | grep -q ':3000 '; then
  echo "Port 3000 is already in use. Frontend is likely already running."
  exit 0
fi

if [ ! -d ".next" ] || [ "$REBUILD" = true ]; then
  echo "Building Next.js frontend..."
  npm run build
fi

echo "Starting Next.js frontend on port 3000..."
nohup npm run start > /tmp/ecommerce-frontend.log 2>&1 &
echo $! > /tmp/ecommerce-frontend.pid

if ss -ltn | grep -q ':3000 '; then
  echo "Frontend is running."
else
  echo "Frontend did not start yet. Check logs: /tmp/ecommerce-frontend.log"
fi
