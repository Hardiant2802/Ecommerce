#!/usr/bin/env bash
set -o errexit

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

REBUILD=false
if [ "${1:-}" = "--rebuild" ]; then
  REBUILD=true
fi

if [ "$REBUILD" = true ]; then
  echo "Rebuilding frontend image..."
  bin/docker-compose build frontend
fi

echo "Starting frontend container..."
bin/docker-compose up -d frontend
bin/docker-compose ps frontend
