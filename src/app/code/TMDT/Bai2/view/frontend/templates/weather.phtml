<div id="weather-widget"></div>

<script>
require(['jquery', 'simple_weather'], function($, weatherModule){
    weatherModule.loadWeather({
        location: 'Hanoi, VN',
        success: function(weather){
            // $ ở đây là jQuery, an toàn
            $('#weather-widget').html(
                '<h3>' + weather.city + '</h3>' +
                '<p>' + weather.temp + '°C - ' + weather.text + '</p>' +
                '<img src="' + weather.icon + '">'
            );
        },
        error: function(err){
            $('#weather-widget').text(err);
        }
    });
});
</script>
